# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Email Service Credentials (Nodemailer / SMTP)
EMAIL_SERVICE=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=concierge@hotelpro.com
EMAIL_PASS=your_email_app_password

# Payment Gateway Keys (Stripe & Razorpay)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RAZORPAY_KEY_ID=rzp_test_your_razorpay_id
RAZORPAY_KEY_SECRET=rzp_test_your_razorpay_secret

# Cloud Storage Keys (AWS S3 / Cloudinary for Room Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
